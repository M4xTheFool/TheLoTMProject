{
  // F5 builds with CMake and runs the program picked under Launch in the CMake panel.
  // If VS Code asks which program to run, pick lotm_window (the app window) or lotm_creator
  // (the console version, which runs in the Terminal panel where you can type).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LoTM Creator (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run LoTM Creator (macOS / Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "osx": { "MIMode": "lldb" },
      "linux": { "MIMode": "gdb" }
    }
  ]
}
